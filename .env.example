# News automation
NEWS_DAILY_TARGET=4
NEWS_TIMEZONE=America/Los_Angeles
NEWS_MAX_RETRIES=2
NEWS_LOOKBACK_HOURS=72
NEWS_DEDUP_DAYS=30
NEWS_RELEVANCE_THRESHOLD=0.55
NEWS_AUTO_PUBLISH=true
NEWS_ALLOWED_LANGUAGES=en
